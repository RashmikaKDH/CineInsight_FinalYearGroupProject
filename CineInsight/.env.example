# ===========================================================================
# CineInsight Environment Variables Configuration Template
# Copy this file to .env and insert your private credentials.
# NEVER commit your actual .env file to Git!
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Preparation Pipeline Configuration (Aspect & Sentiment Extraction)
# ---------------------------------------------------------------------------
# Gemini API Key(s) for initial aspect and sentiment labeling (supports comma-separated keys for rotation)
GEMINI_API_KEYS=your_aspect_extraction_gemini_api_key_here

# YouTube Data API v3 Key (from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Model used for aspect extraction (default: gemini-3.1-flash-lite or gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.1-flash-lite

# Batch and rate limit controls for aspect extraction
GEMINI_SEGMENTS_PER_REQUEST=30
GEMINI_REQUEST_GAP_SECONDS=15

# ---------------------------------------------------------------------------
# 2. Local Inference & Post-SHAP Reasoning Configuration (Standalone Pipeline)
# ---------------------------------------------------------------------------
# IMPORTANT:
# - SHAP numeric feature attribution itself requires NO API key (runs 100% locally on CPU/CUDA).
# - SHAP_GEMINI_API_KEY is used EXCLUSIVELY for generating plain-English AI reasoning
#   explanations after SHAP values have been computed.
# - It is kept strictly independent from GEMINI_API_KEYS above (no fallback).
# - If you run local inference with `--skip-gemini`, no API key is required at all.
SHAP_GEMINI_API_KEY=

# Model used exclusively for SHAP explanation generation.
# Model Selection Precedence Hierarchy:
#   1. CLI argument: `--gemini-model <model>` (highest precedence)
#   2. Process Environment Variable: `SHAP_GEMINI_MODEL` exported in terminal/OS
#      (Note: existing terminal environment values take precedence over .env because override=False)
#   3. .env file setting: `SHAP_GEMINI_MODEL` (loaded if not already in process env)
#   4. Built-in hardcoded fallback: `gemini-3.5-flash-lite` (lowest precedence)
SHAP_GEMINI_MODEL=gemini-3.5-flash-lite
