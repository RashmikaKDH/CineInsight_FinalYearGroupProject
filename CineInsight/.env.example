# ========================================================
# CineInsight Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ========================================================

# --------------------------------------------------------
# 1. Flask & Security Configuration
# --------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-this-to-a-cryptographically-random-secret-key-32-chars

# --------------------------------------------------------
# 2. MySQL / MariaDB Database Settings
# --------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cineinsight_db
DB_PORT=3306

# --------------------------------------------------------
# 3. YouTube Data API v3
# --------------------------------------------------------
YOUTUBE_API_KEY=your_google_cloud_youtube_api_v3_key_here

# --------------------------------------------------------
# 4. SMTP Email Configuration (Password Reset)
# --------------------------------------------------------
# Gmail SMTP (Recommended):
# 1. Use your full Gmail address for SMTP_EMAIL
# 2. Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
#    (Requires 2-Step Verification enabled on your Google account)
# 3. Port 465 uses SSL directly (recommended). Port 587 uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=yourprojectemail@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password

# --------------------------------------------------------
# 5. Base URL for Password Reset Links
# In local development: http://127.0.0.1:5000/reset-password
# In production: https://yourdomain.com/reset-password
# --------------------------------------------------------
RESET_PASSWORD_URL=http://127.0.0.1:5000/reset-password

